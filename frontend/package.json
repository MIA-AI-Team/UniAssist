{
  "name": "uniassist-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src messages tests scripts *.ts *.mjs *.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "9.0.1",
    "katex": "0.18.7",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
