# UniAssist Backend — copy to .env and adjust

# Postgres (matches root docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://uniassist:uniassist@localhost:5432/uniassist

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Uploads
UPLOAD_DIR=uploads

# Optional SQLAlchemy echo
SQL_ECHO=false

# AI provider keys (backend imports ai_tutor in-process)
PRIMARY_PROVIDER=groq
MOCK_MODE=true
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_ENGINE_VERSION=1.4.0
PROMPT_VERSION=2.0.0
