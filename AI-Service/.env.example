# ==============================================================================
# AI Evaluation Assistant - Environment Configuration Template
# Copy this file to .env and fill in your API keys before running the server.
# ==============================================================================

# Primary LLM Provider: 'groq' or 'gemini'
PRIMARY_PROVIDER=groq

# Mock Mode: Set to 'true' to test system offline without API keys
MOCK_MODE=false

# AI versioning (persisted in ai_metadata on responses)
AI_ENGINE_VERSION=1.4.0
PROMPT_VERSION=2.0.0

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# LLM Generation Temperature (0.0 to 1.0)
TEMPERATURE=0.2

# Context budget (character-based ratios should sum to ~1.0)
MAX_TOTAL_PROMPT_CHARS=48000
BUDGET_REFERENCE_RATIO=0.40
BUDGET_RUBRIC_RATIO=0.15
BUDGET_SUBMISSION_RATIO=0.35
BUDGET_CODE_RATIO=0.10

# Per-section caps (characters)
MAX_REFERENCE_CHARS=12000
MAX_SUBMISSION_CHARS=12000
MAX_CODE_FILE_CHARS=8000
MAX_GRADING_KEY_CHARS=6000

# Rubric validation
MIN_RUBRIC_CRITERIA=1
MAX_RUBRIC_CRITERIA=20

# Chat history window (CHAT_MESSAGES → AI chat_history)
MAX_CHAT_HISTORY_MESSAGES=40
