# Root Compose settings. Preserve existing database credentials on upgrades.
# Optional provider secrets: backend/.env and AI-Service/.env.

POSTGRES_USER=uniassist
POSTGRES_PASSWORD=uniassist
POSTGRES_DB=uniassist
POSTGRES_PORT=5432

AI_SERVICE_PORT=8000
BACKEND_PORT=8001
FRONTEND_PORT=3000
APP_URL=http://localhost:3000
# Generate two different persistent secrets before startup. Never commit real secrets.
SECRET_KEY=
SESSION_SECRET=
BACKEND_TIMEOUT_MS=180000

MOCK_MODE=true
MIN_COHORT_SIZE_FOR_PATTERNS=3
ANALYTICS_TIMEOUT_SECONDS=90
